---
import { Picture } from 'astro:assets';
import ProjectDialog from './ProjectDialog.astro';
import type { Site } from '../lib/site';

interface Props {
  projects: Site['projects'];
}
const { projects } = Astro.props;
const FOLD = 6; // with 7+ projects, only the first 6 show until "Show all"
const folds = projects.length > FOLD;
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title">what we've made</h2>
    <ul role="list" class="grid" data-project-grid>
      {
        projects.map((p, i) => (
          <li id={`project-${p.id}`} class="card" data-extra={folds && i >= FOLD ? '' : undefined}>
            <div class="photo">
              <Picture
                src={p.images[0]!.src}
                alt={p.images[0]!.alt}
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                formats={['avif', 'webp']}
              />
            </div>
            <h3>
              <button type="button" class="open" aria-haspopup="dialog" data-open={p.id}>
                {p.title}
              </button>
            </h3>
            <p class="summary">{p.summary}</p>
            <p class="meta">{p.madeFor ? `${p.madeFor} · ${p.year}` : p.year}</p>
          </li>
        ))
      }
    </ul>
    {
      folds && (
        <div class="more">
          <button type="button" class="btn btn--secondary" hidden data-show-all>
            Show all {projects.length} projects
          </button>
        </div>
      )
    }
  </div>
  {projects.map((p) => <ProjectDialog project={p} />)}
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-24);
    margin: 0;
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--space-8);
    align-content: start;
  }

  .photo {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur);
  }

  .card:hover .photo :global(img) {
    transform: scale(1.03);
  }

  /* The title button stretches over the whole card, so the card is one button. */
  .open {
    all: unset;
    cursor: pointer;
  }

  .open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .open:focus-visible {
    outline: none;
  }

  .open:focus-visible::after {
    outline: var(--focus-width) solid var(--ink);
    outline-offset: var(--focus-offset);
  }

  .summary {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  .card[hidden] {
    display: none;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-48);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo :global(img) {
      transition: none;
    }

    .card:hover .photo :global(img) {
      transform: none;
    }
  }
</style>

<script>
  // ---- "Show all" fold (only when JS runs; without JS every project is listed) ----
  const showAll = document.querySelector<HTMLButtonElement>('[data-show-all]');
  const extras = [...document.querySelectorAll<HTMLElement>('[data-extra]')];
  if (showAll && extras.length) {
    extras.forEach((el) => (el.hidden = true));
    showAll.hidden = false;
    showAll.addEventListener('click', () => {
      extras.forEach((el) => (el.hidden = false));
      showAll.hidden = true;
      extras[0]!.querySelector<HTMLButtonElement>('[data-open]')!.focus();
    });
  }

  // ---- Project dialogs ----
  let opener: HTMLElement | null = null;

  function openProject(id: string) {
    const dialog = document.getElementById(`dialog-${id}`) as HTMLDialogElement | null;
    if (!dialog || dialog.open) return;
    const card = document.getElementById(`project-${id}`);
    if (card?.hidden) {
      extras.forEach((el) => (el.hidden = false));
      if (showAll) showAll.hidden = true;
    }
    opener = card?.querySelector<HTMLElement>('[data-open]') ?? null;
    dialog.showModal();
    history.replaceState(null, '', `#project-${id}`);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => openProject(b.dataset.open!)),
  );

  document.querySelectorAll<HTMLDialogElement>('dialog[data-project]').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // backdrop click
    });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', location.pathname + location.search);
      opener?.focus();
    });
  });

  const fromHash = () => {
    const m = location.hash.match(/^#project-([a-z0-9-]+)$/);
    if (m) openProject(m[1]!);
  };
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>
