---
import type { Site } from '../lib/site';

interface Props {
  stats: Site['stats'];
}
const { stats } = Astro.props;

const items = [
  { ...stats.members, label: 'active members' },
  { ...stats.prints, label: 'prints made' },
  { ...stats.donated, label: stats.donatedLabel },
];
const fmt = (n: number) => n.toLocaleString('en-US');
---

<section class="stats on-dark" aria-label="Club by the numbers" data-stats>
  <ul role="list" class="container stat-list">
    {
      items.map((s) => (
        <li class="stat">
          <span class="number">
            <span data-count={s.value}>{fmt(s.value)}</span>
            {s.suffix}
          </span>
          <span class="label">{s.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .stats {
    background: var(--ink);
    color: var(--bg);
    padding-block: var(--space-40);
  }

  .stat-list {
    display: grid;
    margin-block: 0;
  }

  .stat {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-16);
  }

  .stat + .stat {
    border-top: 1px solid color-mix(in srgb, var(--bg), transparent 80%);
  }

  .number {
    font-family: var(--font-heading);
    font-weight: 800;
    font-variation-settings: var(--heading-variation);
    font-size: var(--text-stat);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .stats {
      padding-block: var(--space-48);
    }

    .stat-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-24);
    }

    .stat {
      padding-block: 0;
    }

    .stat + .stat {
      border-top: 0;
    }
  }
</style>

<script>
  // Count up from 0 the first time the band is 50% visible. The final number is
  // already in the HTML, so screen readers and no-JS visitors see the real value.
  const band = document.querySelector<HTMLElement>('[data-stats]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (band && !reduce) {
    const els = [...band.querySelectorAll<HTMLElement>('[data-count]')];
    const fmt = (n: number) => n.toLocaleString('en-US');
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / 1200);
          const eased = 1 - Math.pow(1 - t, 3); // ease-out
          els.forEach((el) => (el.textContent = fmt(Math.round(Number(el.dataset.count) * eased))));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.5 },
    );
    io.observe(band);
  }
</script>
