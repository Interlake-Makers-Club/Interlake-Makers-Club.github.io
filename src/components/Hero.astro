---
import Icon from './Icon.astro';
import ModelCarousel from './ModelCarousel.astro';
import type { Site } from '../lib/site';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-text">
      <h1 id="hero-title">We 3D print things that help.</h1>
      <p class="large-text">
        Interlake High School's Makers' Club is a student-run 3D printing community in Bellevue, WA. We design and print
        useful things for anyone who asks, free, and bring our printers to local outreach events.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={site.requestFormUrl} target="_blank" rel="noopener">
          Request a print<Icon name="external" /><span class="visually-hidden"> (opens in new tab)</span>
        </a>
        <a class="btn btn--secondary" href="#contact">Contact us</a>
      </div>
    </div>
    <div class="hero-visual">
      <ModelCarousel models={site.heroModels} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-48) var(--space-64);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-48);
  }

  .hero-text {
    display: grid;
    gap: var(--space-24);
    align-content: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  @media (max-width: 1023px) {
    .hero-visual {
      max-width: 480px;
      width: 100%;
      margin-inline: auto;
    }
  }

  @media (max-width: 639px) {
    .hero-visual {
      max-width: 400px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      display: flex;
      align-items: center;
      padding-block: var(--space-32);
      min-height: max(var(--hero-min-h), min(calc(100svh - var(--header-h) - var(--space-96)), var(--hero-max-h)));
    }

    .hero-grid {
      width: 100%;
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
