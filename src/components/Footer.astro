---
import Icon from './Icon.astro';
import mark from '../assets/logo/mark.svg';
import type { Site } from '../lib/site';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const year = new Date().getFullYear(); // set at build time
---

<footer class="footer on-dark">
  <div class="container inner">
    <div class="brand">
      <img src={mark.src} alt="" width="32" height="32" />
      <span>Interlake High School Makers' Club · Bellevue, WA</span>
    </div>
    <ul role="list" class="icons">
      <li>
        <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener" aria-label="Instagram (opens in new tab)">
          <Icon name="instagram" />
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} aria-label="Email the club">
          <Icon name="mail" />
        </a>
      </li>
    </ul>
    <p class="copyright">© {year} Interlake Makers' Club</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--bg);
    padding-block: var(--space-48);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .brand img {
    height: var(--logo-h);
    width: auto;
  }

  .icons {
    display: flex;
    gap: var(--space-8);
    margin: 0;
  }

  .icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    color: var(--bg);
  }

  .copyright {
    flex-basis: 100%;
    font-size: var(--text-small);
  }
</style>
